NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Optional AI capture. GEMINI_MODEL defaults to gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=
# Gmail alert ingestion. Run `npm exec tsx scripts/gmail-auth.ts` locally once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Must exactly match the OAuth client redirect URI (default is localhost).
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
CRON_SECRET=
